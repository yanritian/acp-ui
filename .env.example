# Hermes Game Operator Environment Configuration

# Hermes Agent API
HERMES_API_ENDPOINT=https://api.hermes.ai
HERMES_API_KEY=your-api-key-here

# Anthropic API (for Hermes CLI)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Godot Configuration
GODOT_PATH=/path/to/godot
GODOT_VERSION=4.2

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Development
NODE_ENV=development
PORT=1420

# Security
ALLOWED_ORIGINS=http://localhost:1420
MAX_FILE_SIZE=10485760

# Performance
EVENT_POLL_INTERVAL=2000
MAX_EVENTS=100
